  "cards": [
    {
      "dot": "emerald",
      "title": "Strict Backend Security Gate",
      "items": [
        "OrderService validates destination pincode against courier coverage before creating any order",
        "Idempotency keys prevent double-charge or duplicate orders on accidental double-clicks"
      ]
    },
    {
      "dot": "rose",
      "title": "Cryptographic Hash & Webhook",
      "items": [
        "PayU/CCavenue transaction payload hashed with SHA-512 using merchant secret key",
        "Server-to-server webhook verifies HMAC signature to prevent tampered success redirects"
      ]
    },
    {
      "dot": "amber",
      "title": "Atomic State & Async Fulfillment",
      "items": [
        "Order transitions to CONFIRMED and inventory is deducted atomically in MongoDB",
        "Shipment creation and customer invoice email are enqueued asynchronously via BullMQ"
      ]
    }
