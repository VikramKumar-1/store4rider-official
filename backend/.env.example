# ==========================================
# CORE DATABASE & CACHE
# ==========================================
PORT=4000
MONGODB_URI=mongodb://localhost:27017/store4riders
REDIS_URL=redis://localhost:6379

# ==========================================
# AUTHENTICATION & ADMIN
# ==========================================
JWT_SECRET=your_super_secret_jwt_key_here
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here

# (Optional) Admin bypass credentials for testing
ADMIN_BYPASS_EMAIL=admin@store4riders.com
ADMIN_BYPASS_PASSWORD=AdminPassword123!

# ==========================================
# FRONTEND CONNECTION
# ==========================================
FRONTEND_URL=http://localhost:3000
STORE_EMAIL=support@store4riders.com

# ==========================================
# PHASE 4: PAYMENT GATEWAYS
# ==========================================
PAYU_MERCHANT_KEY=your_payu_key
PAYU_SALT=your_payu_salt
CCAVENUE_MERCHANT_ID=your_ccavenue_id
CCAVENUE_ACCESS_CODE=your_ccavenue_access_code
CCAVENUE_WORKING_KEY=your_ccavenue_working_key

# ==========================================
# PHASE 5: SHIPPING LOGISTICS
# ==========================================
SHIPROCKET_EMAIL=your_shiprocket_email@example.com
SHIPROCKET_PASSWORD=your_shiprocket_password

# ==========================================
# PHASE 6: AWS S3 (For PDF Invoices & Images)
# ==========================================
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=store4riders-assets
