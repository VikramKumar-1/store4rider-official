# Database
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/store4riders

# JWT
JWT_ACCESS_SECRET=your-access-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here

# AWS S3 (Image Uploads)
S3_ACCESS_KEY_ID=your-key
S3_SECRET_ACCESS_KEY=your-secret
S3_REGION=ap-south-2
S3_BUCKET=store4riders

# AWS SES (Emails — Amazon Simple Email Service)
SES_ACCESS_KEY_ID=your-key
SES_SECRET_ACCESS_KEY=your-secret
SES_REGION=ap-south-1
SES_FROM_EMAIL=noreply@store4riders.com

# Payment Gateways (PayU, CCAvenue, Snapmint)
PAYU_MERCHANT_KEY=your-payu-key
PAYU_SALT=your-payu-salt
NEXT_PUBLIC_PAYU_MERCHANT_KEY=your-payu-key

CCAVENUE_MERCHANT_ID=your-ccavenue-mid
CCAVENUE_ACCESS_CODE=your-ccavenue-access
CCAVENUE_WORKING_KEY=your-ccavenue-working

SNAPMINT_MERCHANT_ID=your-snapmint-mid
SNAPMINT_SECRET_KEY=your-snapmint-secret

# Meilisearch (Search)
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_KEY=your-master-key

# Redis (Caching)
REDIS_URL=redis://localhost:6379

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000/api
